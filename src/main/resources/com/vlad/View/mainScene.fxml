<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="438.0" prefWidth="782.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vlad.Controllers.mainSceneController">
   <children>
      <Canvas fx:id="canvas" height="350.0" layoutX="441.0" layoutY="20.0" width="379.0" />
      <Button fx:id="startButton" layoutX="66.0" layoutY="378.0" mnemonicParsing="false" onAction="#startDrawing" text="Почати" />
      <Button fx:id="clearButton" layoutX="159.0" layoutY="378.0" mnemonicParsing="false" onAction="#clearCanvas" text="Очистити" />
      <Button fx:id="stopButton" layoutX="265.0" layoutY="378.0" mnemonicParsing="false" text="Зупинити" />
      <Slider fx:id="speedSlider" blockIncrement="1.0" layoutX="67.0" layoutY="343.0" min="1.0" value="50.0" />
      <Label layoutX="67.0" layoutY="300.0" text="Швидкість" />
      <Label layoutX="67.0" layoutY="250.0" text="Кількість точок" />
      <Label layoutX="450.0" layoutY="382.0" text="Кількість намальованих точок" />
      <TextArea fx:id="countDots" layoutX="190.0" layoutY="239.0" prefHeight="38.0" prefWidth="95.0" />
      <Label fx:id="countPaintedDots" layoutX="689.0" layoutY="382.0" prefHeight="16.0" prefWidth="61.0" text="0" />
      <Label fx:id="errorUnderZeroLabel" layoutX="190.0" layoutY="284.0" text="Будь ласка введіть число більше нуля" textFill="RED" visible="false" />
      <Label fx:id="errorNotNumberLabel" layoutX="189.0" layoutY="284.0" text="Будь ласка введіть число" textFill="RED" visible="false" />
   </children>
</AnchorPane>
