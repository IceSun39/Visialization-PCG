<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vlad.Controllers.mainSceneController">
   <children>
      <Canvas fx:id="mainCanvas" height="269.0" layoutX="562.0" layoutY="31.0" width="297.0" />
      <Button fx:id="startButton" layoutX="65.0" layoutY="321.0" mnemonicParsing="false" onAction="#startDrawing" prefHeight="24.0" prefWidth="106.0" text="Почати" />
      <Button fx:id="clearButton" layoutX="193.0" layoutY="373.0" mnemonicParsing="false" onAction="#clearCanvas" prefHeight="24.0" prefWidth="106.0" text="Очистити" />
      <Button fx:id="stopButton" layoutX="193.0" layoutY="321.0" mnemonicParsing="false" onAction="#stopDrawing" prefWidth="105.0" text="Зупинити" />
      <Slider fx:id="speedSlider" blockIncrement="1.0" layoutX="62.0" layoutY="273.0" min="1.0" value="50.0" />
      <Label layoutX="59.0" layoutY="233.0" text="Швидкість" />
      <Label layoutX="59.0" layoutY="128.0" text="Кількість точок" />
      <Label layoutX="562.0" layoutY="321.0" text="Кількість намальованих точок" />
      <TextArea fx:id="countArea" layoutX="182.0" layoutY="117.0" prefHeight="38.0" prefWidth="95.0" text="10000" />
      <Label fx:id="countPaintedDots" layoutX="798.0" layoutY="321.0" prefHeight="16.0" prefWidth="61.0" text="0" />
      <Label fx:id="errorUnderZeroLabel" layoutX="190.0" layoutY="284.0" text="Будь ласка введіть число більше нуля" textFill="RED" visible="false" />
      <Label fx:id="errorNotNumberLabel" layoutX="189.0" layoutY="284.0" text="Будь ласка введіть число" textFill="RED" visible="false" />
      <Button fx:id="continueButton" layoutX="67.0" layoutY="373.0" mnemonicParsing="false" onAction="#startDrawing" prefHeight="24.0" prefWidth="106.0" text="Продовжити" />
      <Label layoutX="59.0" layoutY="187.0" text="Зерно" />
      <TextArea fx:id="seedArea" layoutX="182.0" layoutY="176.0" prefHeight="38.0" prefWidth="95.0" text="42" />
   </children>
</AnchorPane>
