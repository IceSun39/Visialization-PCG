<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="850.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vlad.Controllers.mainSceneController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="Файл">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#saveToFile" text="Зберегти як" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Допомога">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Про програму" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <VBox prefWidth="250.0" spacing="20.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="section-header" text="Параметри" />

                <VBox spacing="5.0">
                    <Label text="Кількість точок:" />
                    <TextField fx:id="countArea" text="10000" />
                    <Label fx:id="errorNotNumberLabel" managed="${errorNotNumberLabel.visible}" styleClass="error-label" text="Будь ласка, введіть число" visible="false" />
                    <Label fx:id="errorUnderZeroLabel" managed="${errorUnderZeroLabel.visible}" styleClass="error-label" text="Введіть число більше нуля" visible="false" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Зерно (Seed):" />
                    <TextField fx:id="seedArea" text="42" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Швидкість:" />
                    <Slider fx:id="speedSlider" blockIncrement="1.0" min="1.0" value="50.0" />
                </VBox>

                <Label styleClass="section-header" text="Керування" />

                <VBox spacing="10.0">
                    <Button fx:id="startButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#startDrawing" styleClass="btn-primary" text="Почати візуалізацію" />
                    <Button fx:id="continueButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#startDrawing" styleClass="btn-info" text="Продовжити" />
                    <Button fx:id="stopButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#stopDrawing" styleClass="btn-danger" text="Зупинити" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quickGeneration" styleClass="btn-secondary" text="Швидко створити" />
                    <Button fx:id="clearButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#clearCanvas" styleClass="btn-warning" text="Очистити" />
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="15.0" styleClass="canvas-container" BorderPane.alignment="CENTER">
            <children>
                <Canvas fx:id="mainCanvas" height="400.0" styleClass="canvas-view" width="500.0" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label styleClass="canvas-label" text="Кількість намальованих точок:" />
                        <Label fx:id="countPaintedDots" styleClass="highlight-label" text="0" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
